<UserControl x:Class="MrInsight.BadgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MrInsight">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="Firebrick" TextWrapping="Wrap" />
        <Button Grid.Row="1" Content="再読み込み" Command="{Binding RefreshCommand, Mode=OneTime}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="バッジ名" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding AddBadgeBadgeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" VerticalContentAlignment="Center" Margin="0,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddBadgeCommand, Mode=OneTime}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="バッジの追加" Command="{Binding AddBadgeCommand, Mode=OneTime}" Padding="12,4" />
        </StackPanel>
        <GroupBox Grid.Row="3" Header="バッジ表" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding BadgeTableItemList, Mode=OneWay}" SelectedItem="{Binding BadgeTableSelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="バッジ名" Binding="{Binding BadgeName, Mode=OneWay}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <Button Grid.Row="4" Content="バッジの削除" Command="{Binding DeleteBadgeCommand, Mode=OneTime}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" />
        <GroupBox Grid.Row="5" Header="未登録のバッジ表" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding UnregisteredBadgeTableItemList, Mode=OneWay}" SelectedItem="{Binding UnregisteredBadgeTableSelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="バッジ名" Binding="{Binding BadgeName, Mode=OneWay}" />
                    <DataGridTextColumn Header="件数" Binding="{Binding Count, Mode=OneWay}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <Button Grid.Row="6" Content="未登録のバッジの登録" Command="{Binding RegisterBadgeCommand, Mode=OneTime}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" />
    </Grid>
</UserControl>
