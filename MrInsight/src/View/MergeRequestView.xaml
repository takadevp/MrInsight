<UserControl x:Class="MrInsight.MergeRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MrInsight">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="Firebrick" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="プロジェクトの取り込み" Command="{Binding ImportProjectCommand, Mode=OneTime}" Padding="12,4" />
            <Button Content="キャンセル" Command="{Binding ImportProjectCancelCommand, Mode=OneTime}" Margin="8,0,0,0" Padding="12,4" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="プロジェクト" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding ProjectItemList, Mode=OneWay}" SelectedItem="{Binding ProjectSelectedItem, Mode=TwoWay}" DisplayMemberPath="ProjectPath" MinWidth="320" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="マージリクエストの取り込み" Command="{Binding ImportMergeRequestCommand, Mode=OneTime}" Padding="12,4" />
            <Button Content="キャンセル" Command="{Binding ImportMergeRequestCancelCommand, Mode=OneTime}" Margin="8,0,0,0" Padding="12,4" />
        </StackPanel>
        <GroupBox Grid.Row="4" Header="マージリクエスト表" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding MergeRequestTableItemList, Mode=OneWay}" SelectedItem="{Binding MergeRequestTableSelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IID" Binding="{Binding Iid, Mode=OneWay}" />
                    <DataGridTextColumn Header="タイトル" Binding="{Binding Title, Mode=OneWay}" />
                    <DataGridTextColumn Header="作成者ユーザー名" Binding="{Binding AuthorUsername, Mode=OneWay}" />
                    <DataGridTextColumn Header="状態" Binding="{Binding State, Mode=OneWay}" />
                    <DataGridTextColumn Header="作成日" Binding="{Binding CreatedAt, Mode=OneWay, StringFormat='yyyy/MM/dd HH:mm'}" />
                    <DataGridTextColumn Header="マージ日" Binding="{Binding MergedAt, Mode=OneWay, StringFormat='yyyy/MM/dd HH:mm'}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Row="5" Header="スレッド表" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding ThreadTableItemList, Mode=OneWay}" SelectedItem="{Binding ThreadTableSelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="作成日" Binding="{Binding CreatedAt, Mode=OneWay, StringFormat='yyyy/MM/dd HH:mm'}" />
                    <DataGridTextColumn Header="最初に書いた人のユーザー名" Binding="{Binding FirstAuthorUsername, Mode=OneWay}" />
                    <DataGridTextColumn Header="ファイルパス" Binding="{Binding FilePath, Mode=OneWay}" />
                    <DataGridTextColumn Header="行" Binding="{Binding LineNumber, Mode=OneWay}" />
                    <DataGridTextColumn Header="解決済み" Binding="{Binding Resolved, Mode=OneWay}" />
                    <DataGridTextColumn Header="コメント数" Binding="{Binding CommentCount, Mode=OneWay}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Grid.Row="6" Header="コメント表" Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding CommentTableItemList, Mode=OneWay}" SelectedItem="{Binding CommentTableSelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="作成日" Binding="{Binding CreatedAt, Mode=OneWay, StringFormat='yyyy/MM/dd HH:mm'}" />
                    <DataGridTextColumn Header="作成者ユーザー名" Binding="{Binding AuthorUsername, Mode=OneWay}" />
                    <DataGridTextColumn Header="コメント本文" Binding="{Binding Body, Mode=OneWay}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
